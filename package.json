{
  "name": "qagent-ui-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic execution of immutable QAgent observed UI plans",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "bin": { "qagent-ui-runner": "src/cli.js" },
  "scripts": {
    "build": "npm run check",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser.acceptance.js",
    "browser:install": "playwright install chromium",
    "start": "node src/cli.js"
  },
  "dependencies": { "playwright": "1.62.1" }
}
